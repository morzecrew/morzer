<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>dev.morzer.demo-update</string>
	<key>ProgramArguments</key>
	<array>
		<string>/usr/local/bin/morzer</string>
		<string>update</string>
		<string>--unattended</string>
		<string>--plain</string>
		<string>--log-format</string>
		<string>json</string>
		<string>--config</string>
		<string>/etc/demo/installation.yaml</string>
	</array>
	<key>EnvironmentVariables</key>
	<dict>
		<key>PATH</key>
		<string>/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
	</dict>
	<key>StartCalendarInterval</key>
	<array>
		<dict>
			<key>Weekday</key>
			<integer>0</integer>
			<key>Hour</key>
			<integer>4</integer>
			<key>Minute</key>
			<integer>0</integer>
		</dict>
		<dict>
			<key>Weekday</key>
			<integer>6</integer>
			<key>Hour</key>
			<integer>4</integer>
			<key>Minute</key>
			<integer>0</integer>
		</dict>
	</array>
	<key>StandardOutPath</key>
	<string>/var/lib/demo/logs/dev.morzer.demo-update.log</string>
	<key>StandardErrorPath</key>
	<string>/var/lib/demo/logs/dev.morzer.demo-update.log</string>
</dict>
</plist>
