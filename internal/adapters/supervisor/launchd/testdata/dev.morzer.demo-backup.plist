<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>dev.morzer.demo-backup</string>
	<key>ProgramArguments</key>
	<array>
		<string>/usr/local/bin/morzer</string>
		<string>backup</string>
		<string>--unattended</string>
		<string>--yes</string>
		<string>--plain</string>
		<string>--log-format</string>
		<string>json</string>
		<string>--config</string>
		<string>/etc/demo/installation.yaml</string>
	</array>
	<key>EnvironmentVariables</key>
	<dict>
		<key>PATH</key>
		<string>/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
		<key>MORZER_STAMP_LINES</key>
		<string>1</string>
	</dict>
	<key>StartCalendarInterval</key>
	<dict>
		<key>Hour</key>
		<integer>2</integer>
		<key>Minute</key>
		<integer>30</integer>
	</dict>
	<key>StandardOutPath</key>
	<string>/var/lib/demo/logs/dev.morzer.demo-backup.log</string>
	<key>StandardErrorPath</key>
	<string>/var/lib/demo/logs/dev.morzer.demo-backup.log</string>
</dict>
</plist>
