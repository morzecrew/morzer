{
  "$id": "https://morzecrew.github.io/morzer/schemas/selfhost-v1alpha1-secrets.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "The declaration of what secrets a release needs, templates/secrets.yaml. Generated from the Go types; do not edit by hand.",
  "properties": {
    "api_version": {
      "enum": [
        "selfhost/v1alpha1"
      ],
      "type": "string"
    },
    "secrets": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "description": {
            "type": "string"
          },
          "file": {
            "type": "string"
          },
          "generator": {
            "additionalProperties": false,
            "properties": {
              "alphabet": {
                "type": "string"
              },
              "kind": {
                "enum": [
                  "password",
                  "hex",
                  "base64",
                  "age-key",
                  "uuid"
                ],
                "type": "string"
              },
              "length": {
                "type": "integer"
              }
            },
            "type": "object"
          },
          "name": {
            "type": "string"
          },
          "required": {
            "type": "boolean"
          },
          "rotation_period": {
            "description": "A duration, e.g. 30s or 10m.",
            "examples": [
              "30s",
              "10m"
            ],
            "pattern": "^\\d+(?:\\.\\d+)?(?:ns|us|ms|s|m|h)(?:\\d+(?:\\.\\d+)?(?:ns|us|ms|s|m|h))*$",
            "type": "string"
          },
          "services": {
            "items": {
              "type": "string"
            },
            "type": "array"
          }
        },
        "type": "object"
      },
      "type": "array"
    }
  },
  "required": [
    "api_version",
    "secrets"
  ],
  "title": "morzer secret schema",
  "type": "object"
}
