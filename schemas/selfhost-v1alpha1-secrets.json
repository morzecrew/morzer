{
  "$id": "https://morzecrew.github.io/morzer/schemas/selfhost-v1alpha1-secrets.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "The declaration of what secrets a release needs, conventionally secrets.schema.yaml at the bundle root, though the manifest names the path. Generated from the Go types; do not edit by hand.",
  "properties": {
    "api_version": {
      "enum": [
        "selfhost/v1alpha1"
      ],
      "type": "string"
    },
    "secrets": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "description": {
            "type": "string"
          },
          "file": {
            "type": "string"
          },
          "generator": {
            "additionalProperties": false,
            "properties": {
              "alphabet": {
                "type": "string"
              },
              "kind": {
                "enum": [
                  "password",
                  "hex",
                  "base64",
                  "age-key",
                  "uuid"
                ],
                "type": "string"
              },
              "length": {
                "type": "integer"
              }
            },
            "type": "object"
          },
          "name": {
            "type": "string"
          },
          "owner": {
            "description": "The numeric uid, or uid:gid, the rendered file is given to, each from 0 to 4294967294. A name is refused: the user that reads the file is the image's, not this host's. Needs compatibility.min_manager_version 0.6.0 or later.",
            "examples": [
              "65532",
              "65532:65532"
            ],
            "pattern": "^\\d{1,10}(?::\\d{1,10})?$",
            "type": "string"
          },
          "required": {
            "type": "boolean"
          },
          "rotation_period": {
            "description": "A duration, e.g. 30s or 10m.",
            "examples": [
              "30s",
              "10m"
            ],
            "pattern": "^\\d+(?:\\.\\d+)?(?:ns|us|ms|s|m|h)(?:\\d+(?:\\.\\d+)?(?:ns|us|ms|s|m|h))*$",
            "type": "string"
          },
          "services": {
            "items": {
              "type": "string"
            },
            "type": "array"
          }
        },
        "type": "object"
      },
      "type": "array"
    }
  },
  "required": [
    "api_version",
    "secrets"
  ],
  "title": "morzer secret schema",
  "type": "object"
}
