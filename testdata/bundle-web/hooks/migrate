#!/bin/sh
# Migration hook. Exit 0 means migrations ran, exit 2 means already current.
set -eu

marker="${WEB_DATA_DIR:?WEB_DATA_DIR is required}/.schema"
target=1

mkdir -p "$(dirname "$marker")"
current=0
[ -f "$marker" ] && current=$(cat "$marker")

if [ "$current" -ge "$target" ]; then
    printf '{"message":"schema already at %s","schema_version":%s,"skipped":true}' \
        "$current" "$current" >&"${WEB_RESULT_FD:-3}"
    echo "schema already at $current"
    exit 2
fi

echo "migrating schema $current -> $target"
echo "$target" > "$marker"
printf '{"message":"migrated %s -> %s","schema_version":%s}' \
    "$current" "$target" "$target" >&"${WEB_RESULT_FD:-3}"
